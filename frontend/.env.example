# Frontend Environment Configuration Template (Expo SDK 57)

# Backend REST API URL
EXPO_PUBLIC_API_URL=https://your-backend-api.com/api/partner/

# Real-Time Matchmaking Socket Engine
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Google OAuth Client IDs for Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Mappls (MapmyIndia) API Keys (https://apis.mappls.com/)
EXPO_PUBLIC_MAPPLS_REST_KEY=your-mappls-rest-key
EXPO_PUBLIC_MAPPLS_CLIENT_ID=your-mappls-client-id
EXPO_PUBLIC_MAPPLS_CLIENT_SECRET=your-mappls-client-secret

# Agora RTC Live Audio/Video Calling App ID
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id
